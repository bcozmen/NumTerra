from scipy.ndimage import map_coordinates
from dataclasses import dataclass
import numpy as np

from scipy.ndimage import gaussian_filter

@dataclass
class HumidityConfig:
    iterations: int = 80
    dt: float = 3600  # seconds per iteration

    evaporation_rate: float = 0.02
    diffusion_sigma: float = 0.6

    orographic_factor: float = 2.0
    condensation_rate: float = 0.5

    sea_evaporation: float = 1.0
    lake_evaporation: float = 0.7
    river_evaporation: float = 0.3
    land_evaporation: float = 0.05

#create
# humidity - atmospheric water vapor
# clouds - condensed water
# rain - precipitated water
#soil_moisture - water in soil, affects vegetation and runoff
class Humidity:
    def __init__(self, worldConfig):
        self.worldConfig = worldConfig
        self.worldConfig["model_humidity"] = self
        self.config = HumidityConfig()
        self.run()

    def __call__(self, area):
        if area is None: self.run()
        else: self.generate(area)
    
    def run(self):
        humidity_map, rain_map = self.init_humidity_map()
        self.worldConfig["humidity"] =  FastInterpolator(humidity_map, order=1)
        self.worldConfig["rain"] = FastInterpolator(rain_map, order=1)

    def generate(self, area):
        grid, points, size = area.grid, area.points, area.size
        area["humidity"] = self.worldConfig["humidity"](points).reshape(size)

    def get_maps(self):
        return {
            "config": self.config,
            "temperature": self.worldConfig["temperature"](),
            "sun": self.worldConfig["sun"](),
            "wind": self.worldConfig["wind"](),
            "sea_mask": self.worldConfig["sea_mask"](),
            "lake_mask": self.worldConfig["lake_mask"]() if "lake_mask" in self.worldConfig.maps else np.zeros_like(self.worldConfig["sea_mask"](), dtype=bool),
            "river_mask": self.worldConfig["river_mask"]() if "river_mask" in self.worldConfig.maps else np.zeros_like(self.worldConfig["sea_mask"](), dtype=bool),
            "grad_i": self.worldConfig["grad_i"](),
            "grad_j": self.worldConfig["grad_j"](),
            "humidity": self.worldConfig["humidity"]() if "humidity" in self.worldConfig.maps else np.zeros_like(self.worldConfig["temperature"]()),
            "rain": self.worldConfig["rain"]() if "rain" in self.worldConfig.maps else np.zeros_like(self.worldConfig["temperature"]()),
            
        }

    def init_humidity_map(self):
        maps = self.get_maps()

        for _ in range(self.config.iterations):
            evap = compute_evaporation(**maps)
            maps["humidity"] = maps["humidity"] + evap * self.config.dt

            maps["humidity"] = advect(**maps)

            maps["humidity"] = gaussian_filter(maps["humidity"], sigma=self.config.diffusion_sigma)

            maps["humidity_max"] = humidity_capacity(**maps)
            rain_sat = saturation_rain(**maps)
            rain_orographic = orographic_rain(**maps)
            total_rain = rain_sat + rain_orographic
            maps["humidity"] = maps["humidity"] - total_rain * self.config.dt
            maps["humidity"] = np.maximum(maps["humidity"], 0)

            maps["rain"] += (total_rain / self.config.iterations)

        return maps["humidity"], maps["rain"]

    def _generate_humidity_map(self, grid, points, size):
        height = self.worldConfig["height"](points).reshape(size)
        sea_mask = self.worldConfig["sea_mask"](points).reshape(size)

        humidity = np.zeros_like(height)
        humidity[sea_mask] = 1.0  # Max humidity at sea
        humidity[~sea_mask] = np.exp(-height[~sea_mask] / self.worldConfig.max_altitude)  # Decrease with height

        return humidity

def asd():
    pass



def compute_evaporation(config, temperature, sun,wind, sea_mask, lake_mask, river_mask, **kwargs):
    wind_speed = np.linalg.norm(wind, axis=-1)

    water_factor = np.full_like(temperature,
                                config.land_evaporation)

    water_factor[sea_mask] = config.sea_evaporation
    water_factor[lake_mask] = config.lake_evaporation
    water_factor[river_mask] = config.river_evaporation
    temp_factor = np.exp(0.05 * (temperature - 15))

    sun_factor = 0.5 + 0.5 * sun

    wind_factor = 1.0 + 0.05 * wind_speed

    evap = (
        config.evaporation_rate *
        water_factor *
        temp_factor *
        sun_factor *
        wind_factor
    )

    return evap

def humidity_capacity(temperature, **kwargs):
    return np.exp(0.06 * temperature)

def saturation_rain(config,humidity,humidity_max, **kwargs):
    excess = humidity - humidity_max

    rain = np.maximum(excess, 0)

    return rain * config.condensation_rate

def saturation_rain(config, humidity, humidity_max, **kwargs ):
    excess = humidity - humidity_max

    rain = np.maximum(excess, 0)

    return rain * config.condensation_rate

def orographic_rain(config, humidity, wind, grad_i, grad_j, **kwargs):
    wind_speed = np.linalg.norm(wind, axis=-1) + 1e-8

    wx = wind[..., 0] / wind_speed
    wy = wind[..., 1] / wind_speed

    uplift = (wx * grad_i + wy * grad_j)
    uplift = np.maximum(uplift, 0)
    uplift = np.tanh(5 * uplift)  # nonlinearity to limit extreme values

    rain = (humidity * uplift * config.orographic_factor)

    return rain


def advect(config, humidity, wind, **kwargs):
    h, w = humidity.shape

    ii, jj = np.meshgrid(np.arange(h),np.arange(w),indexing='ij')

    prev_i = ii - (wind[..., 0] * config.dt / config.cell_size[0])
    prev_j = jj - (wind[..., 1] * config.dt / config.cell_size[1])

    coords = np.array([prev_i, prev_j])
    
    advected = map_coordinates(humidity, coords, order=1, mode='reflect')
    return advected